# Base de datos PostgreSQL.
# Opción A (recomendada en Vercel): la integración Vercel Postgres/Neon inyecta automáticamente
# variables con el prefijo del store. Si el store se llama "POSTGRES_PRISMA_URL", quedan así:
POSTGRES_PRISMA_URL_POSTGRES_PRISMA_URL="postgresql://user:password@host-XXXX-pooler.region.aws.neon.tech/dbname?sslmode=require"
POSTGRES_PRISMA_URL_POSTGRES_URL_NON_POOLING="postgresql://user:password@host-XXXX.region.aws.neon.tech/dbname?sslmode=require"
# Opción B (Postgres estándar): url = env("POSTGRES_PRISMA_URL"), directUrl = env("POSTGRES_URL_NON_POOLING")

# Auth de NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del admin para el seed
ADMIN_EMAIL="admin@tienda.com"
ADMIN_PASSWORD="admin123"

# Vercel Blob (para subir imágenes de productos)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"