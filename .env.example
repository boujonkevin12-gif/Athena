# Base de datos PostgreSQL (Vercel Postgres inyecta POSTGRES_PRISMA_URL y POSTGRES_URL_NON_POOLING automáticamente)
# Para desarrollo local, creá una base Postgres (puede ser la misma de Vercel) y copiá sus URLs a .env
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname"

# Auth de NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del admin para el seed
ADMIN_EMAIL="admin@tienda.com"
ADMIN_PASSWORD="admin123"

# Vercel Blob (para subir imágenes de productos)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"